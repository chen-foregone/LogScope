DATABASE_URL=postgresql+psycopg://logscope:logscope@localhost:5432/logscope
# 服务目录仅维护服务及来源标识；省略时无可选服务，无真实来源连接。
# SERVICES_FILE=backend/services.example.json
# EXECUTOR_CREDENTIAL 仅由安全环境注入；无值时执行端全部拒绝，勿写前端或提交真实值。
# Agent 配置边界已建立，执行器尚未接通；开启配置不代表会启动真实模型。
# DASHSCOPE_API_KEY 仅由安全环境注入，不在此填写。
AGENT_ENABLED=false
AGENT_MODEL=qwen-plus
AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 确认 API Key 地域与上述端点匹配后才能设为 true。
AGENT_REGION_CONFIRMED=false
# 本次联调累计预算最多 10 元；1 元 = 1000000 微元，不是每轮额度。
AGENT_BUDGET_MICROYUAN=10000000
# 下列单价必须核对实际百炼价格后填写，单位为微元/百万 token，不提供猜测价格。
# AGENT_INPUT_MICROYUAN_PER_MILLION_TOKENS=
# AGENT_OUTPUT_MICROYUAN_PER_MILLION_TOKENS=
# AGENT_PRICE_VERSION=
